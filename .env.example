# ── Вход в кабинет (обязательно на проде) ───────────────────────────────────
# Без этой переменной кабинет, AI-помощник и ERP закрыты для всех.
# Ключ подписи сессии выводится из пароля, отдельной переменной не нужно.
ADMIN_PASSWORD=
# Логин. Необязателен: если пуст, проверяется только пароль.
ADMIN_USER=

# ── AI-помощник ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── ERP ─────────────────────────────────────────────────────────────────────
# Путь к erp.db на постоянном томе Railway, иначе данные сбрасываются при деплое.
DB_PATH=
# Где лежат PDF-отчёты по этапам.
REPORTS_DIR=

# ── Источник данных кабинета ────────────────────────────────────────────────
#   local — выгрузка фонда из репозитория (по умолчанию)
#   mock  — демо-данные
#   http  — внешний API Subsoil
NEXT_PUBLIC_API_MODE=local
NEXT_PUBLIC_API_URL=
